{
  // Static site on Cloudflare Workers. Cloudflare's Git integration (Workers Builds) runs
  // `npm run build`, which puts index.html and og-image.png in ./dist, then `npx wrangler deploy`.
  "name": "qolbar-editor",
  "compatibility_date": "2026-09-01",
  // No per-version preview links; the main workers.dev URL is the only one
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  }
}
